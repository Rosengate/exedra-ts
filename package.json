{
  "name": "exedra-ts",
  "version": "0.1.0",
  "description": "Class/convention-based routing for Express.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "example": "ts-node --project tsconfig.example.json examples/app.ts",
    "example:watch": "ts-node-dev --respawn --project tsconfig.example.json examples/app.ts",
    "example:routes": "ts-node --project tsconfig.example.json examples/app.ts --routes",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/reflect-metadata": "^0.1.0",
    "express": "^4.18.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "express",
    "routing",
    "decorators",
    "controllers",
    "typescript"
  ],
  "license": "MIT"
}
