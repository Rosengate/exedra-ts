{
  "name": "@rosengate/exedra-ts",
  "version": "1.0.2",
  "description": "Class/convention-based routing for Express.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "example": "ts-node --project tsconfig.example.json examples/app.ts",
    "example:watch": "ts-node-dev --respawn --project tsconfig.example.json examples/app.ts",
    "example:routes": "ts-node --project tsconfig.example.json examples/app.ts --routes",
    "examples:document-structure": "ts-node --project tsconfig.example.json examples/generate-readme.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/reflect-metadata": "^0.1.0",
    "eslint": "^10.8.0",
    "express": "^4.18.0",
    "jest": "^29.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "express",
    "routing",
    "decorators",
    "controllers",
    "typescript"
  ],
  "license": "MIT"
}
